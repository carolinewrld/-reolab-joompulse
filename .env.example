# ── App ─────────────────────────────────────────────────────────────
APP_ENV=dev
LOG_LEVEL=INFO
ENCRYPTION_KEY=                       # 32-byte urlsafe base64 (see `joompulse gen-key`)

# ── Postgres ────────────────────────────────────────────────────────
POSTGRES_DSN=postgresql+asyncpg://joompulse:joompulse@postgres:5432/joompulse
POSTGRES_DSN_SYNC=postgresql://joompulse:joompulse@postgres:5432/joompulse

# ── Redis ───────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── S3 / MinIO ──────────────────────────────────────────────────────
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=joompulse-assets
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# ── Meta ────────────────────────────────────────────────────────────
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_AD_ACCOUNT_IDS=act_xxx,act_yyy
META_API_VERSION=v21.0

# ── Anthropic ───────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
CLAUDE_MODEL_DECOMPOSE=claude-opus-4-7
CLAUDE_MODEL_ANALYZE=claude-sonnet-4-6
CLAUDE_MODEL_FAST=claude-haiku-4-5

# ── Telegram ────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALERT_CHAT_ID=
TELEGRAM_DIGEST_CHAT_ID=

# ── Thresholds ──────────────────────────────────────────────────────
IMPRESSIONS_THRESHOLD=1000
REANALYZE_COOLDOWN_H=48
BENCHMARK_WINDOW_DAYS=30
VIDEO_SAMPLE_FPS=1
VIDEO_FRAMES_PER_REQUEST=15

# ── Observability ───────────────────────────────────────────────────
SENTRY_DSN=
